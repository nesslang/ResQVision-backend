# Database
DATABASE_URL=postgresql://resqvision:resqvision@localhost:5432/resqvision
DEV_DATABASE_URL=sqlite:///./resqvision_dev.db
USE_DEV_DB=false

# Security
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_NAME=ResQVision 2.0
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ML Models
MODEL_DIR=app/ml/models
MODEL_CACHE_TTL=3600

# Hazard Thresholds (0-100 scale)
HAZARD_SAFE_MAX=39
HAZARD_WARNING_MAX=69
HAZARD_RED_MIN=70

# Priority Thresholds
PRIORITY_IMMEDIATE_MIN=80
PRIORITY_SHORT_TERM_MIN=60

# Site Suitability Weights (must sum to 1.0)
WEIGHT_SAFETY=0.35
WEIGHT_INFRASTRUCTURE=0.25
WEIGHT_LAND=0.15
WEIGHT_ACCESSIBILITY=0.10
WEIGHT_WATER=0.05
WEIGHT_HEALTHCARE=0.05
WEIGHT_POPULATION_PRESSURE=0.05

# Priority Score Weights
WEIGHT_HAZARD_RISK=0.40
WEIGHT_VULNERABILITY=0.35
WEIGHT_ACCESSIBILITY_RISK=0.15
WEIGHT_HOUSING=0.10

# Capacity Safety Margins
CAPACITY_SAFETY_MARGIN=0.85

# Infrastructure Pressure Thresholds (%)
PRESSURE_LOW_MAX=50
PRESSURE_MODERATE_MAX=75
PRESSURE_HIGH_MAX=90
PRESSURE_CRITICAL_MAX=100

# Optimization
OPT_MAX_ITERATIONS=50
OPT_TIME_LIMIT_SECONDS=30

# File Upload
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=csv,json,geojson,xlsx

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
